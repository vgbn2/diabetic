# Copy to .env and replace every CHANGE_ME value. Never commit .env.
BIO_ENVIRONMENT=production
NIGHTSCOUT_API_SECRET=CHANGE_ME_AT_LEAST_12_CHARACTERS
NIGHTSCOUT_PUBLIC_URL=http://localhost:1337
NIGHTSCOUT_BIND_ADDRESS=127.0.0.1
BIO_QUANT_BIND_ADDRESS=127.0.0.1

# The Compose service overrides these with private container-network addresses.
NIGHTSCOUT_URL=http://localhost:1337
MONGO_URI=mongodb://localhost:27017/nightscout
MONGODB_URI=

TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=0
OPENWEATHER_API_KEY=
HEART_RATE_SENSOR_ADDRESS=MOCK
WEATHER_MOCK_MODE=false
BIO_AUTO_TRAIN_ENABLED=false
BIO_RETENTION_DAYS=180
BIO_HUD_STALE_AFTER_SECS=900

# Patient fields remain local and are masked by the settings command.
PATIENT_AGE=30
PATIENT_WEIGHT_KG=70
PATIENT_HEIGHT_CM=170
PATIENT_DIABETES_TYPE=T1D
PATIENT_GENDER=OTHER
PATIENT_ETHNICITY=UNKNOWN
PATIENT_NATIONALITY=UNKNOWN
PATIENT_RELIGION=NON_RELIGIOUS
